ENVIRONMENT=development
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true
STARTUP_STRICT=false

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=xsentinel
MYSQL_USER=xsentinel
MYSQL_PASSWORD=replace-me
# MYSQL_DSN=mysql+aiomysql://xsentinel:replace-me@mysql:3306/xsentinel?charset=utf8mb4

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-me
# REDIS_URL=redis://:replace-me@redis:6379/0

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
DEFAULT_POLL_INTERVAL_SECONDS=300
WORKER_MAX_CONCURRENCY=5
WORKER_METRICS_PORT=8001
PAGINATION_RESUME_DELAY_SECONDS=1
X_AUTH_GATE_SECONDS=300
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# AI provider secrets are consumed by `python -m app.ai_worker` only.
OPENAI_API_KEY=
CODEX_BRIDGE_TOKEN=
# Provider URLs are managed through /api/v1/ai/settings and stored in MySQL.
AI_ALLOWED_PROVIDER_HOSTS=["api.openai.com"]
AI_WORKER_SCAN_INTERVAL_SECONDS=2
AI_WORKER_MAX_CONCURRENCY=3
AI_WORKER_BATCH_SIZE=50
AI_WORKER_LOCK_TTL_SECONDS=180
AI_WORKER_HEARTBEAT_TTL_SECONDS=30
AI_WORKER_METRICS_PORT=8002
CORS_ORIGINS=["http://localhost:5173"]
