ENVIRONMENT=development
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true
STARTUP_STRICT=false

# Optional Nacos Config bootstrap. Shared settings below may live only in the
# remote document; local values remain first-boot and development fallbacks.
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=public
NACOS_GROUP=X_SENTINEL
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_CONFIG_ENABLED=true
NACOS_CONFIG_DATA_ID=x-sentinel-config.json
NACOS_CONFIG_GROUP=X_SENTINEL
NACOS_CONFIG_TIMEOUT_SECONDS=3
NACOS_CONFIG_REQUIRED=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=xsentinel
POSTGRES_USER=xsentinel
POSTGRES_PASSWORD=replace-me
# POSTGRES_DSN=postgresql+asyncpg://xsentinel:replace-me@postgres:5432/xsentinel

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-me
# REDIS_URL=redis://:replace-me@redis:6379/0

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# X Bearer Token is entered in the administration UI and encrypted in PostgreSQL.
X_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
X_TOKEN_CACHE_TTL_SECONDS=300
X_API_BASE_URL=https://api.x.com/2
DEFAULT_POLL_INTERVAL_SECONDS=300
WORKER_MAX_CONCURRENCY=5
WORKER_METRICS_PORT=8201
PAGINATION_RESUME_DELAY_SECONDS=1
X_AUTH_GATE_SECONDS=300
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# AI Base URL, model and API Key are managed through /api/v1/ai-data-source.
AI_WORKER_SCAN_INTERVAL_SECONDS=2
AI_WORKER_MAX_CONCURRENCY=3
AI_WORKER_BATCH_SIZE=50
AI_WORKER_LOCK_TTL_SECONDS=180
AI_WORKER_HEARTBEAT_TTL_SECONDS=30
AI_WORKER_METRICS_PORT=8202

# Tencent QQ bot credentials are encrypted in PostgreSQL and managed through /api/v1/qq.
QQ_AUTH_URL=https://bots.qq.com/app/getAppAccessToken
QQ_API_BASE_URL=https://api.sgroup.qq.com/
QQ_REQUEST_TIMEOUT_SECONDS=20
QQ_WORKER_SCAN_INTERVAL_SECONDS=2
QQ_WORKER_MAX_CONCURRENCY=5
QQ_WORKER_BATCH_SIZE=100
QQ_WORKER_SEND_INTERVAL_SECONDS=5
QQ_WORKER_MAX_ATTEMPTS=3
QQ_WORKER_LOCK_TTL_SECONDS=60
QQ_WORKER_HEARTBEAT_TTL_SECONDS=30
QQ_WORKER_PORT=8203
QQ_WORKER_METRICS_PORT=8004

# Xiaohongshu persistent Camoufox pool.
XHS_JOB_TIMEOUT_SECONDS=300
XHS_JOB_RESULT_TTL_SECONDS=300
XHS_BROWSER_POOL_SIZE=1
XHS_BROWSER_MAX_CONCURRENCY=1
XHS_WORKER_HEARTBEAT_TTL_SECONDS=30
XHS_WORKER_METRICS_PORT=8005
CORS_ORIGINS=["http://localhost:5173"]
