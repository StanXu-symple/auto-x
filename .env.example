# X Sentinel runtime
APP_NAME="X Sentinel"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
STARTUP_STRICT=true
AUTO_CREATE_TABLES=true
TZ=Asia/Shanghai
IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/stanxu-symple/auto-x-backend
FRONTEND_IMAGE=ghcr.io/stanxu-symple/auto-x-frontend

# Public web entrypoint
APP_BIND_IP=0.0.0.0
APP_PORT=8080
BACKEND_HOST_PORT=8000
BACKEND_BIND_IP=0.0.0.0
POSTGRES_HOST_PORT=5432
POSTGRES_BIND_IP=0.0.0.0
REDIS_HOST_PORT=6379
REDIS_BIND_IP=0.0.0.0
WORKER_HOST_PORT=8001
AI_WORKER_HOST_PORT=8002
QQ_WORKER_HOST_PORT=8003
XHS_WORKER_HOST_PORT=8006
AUTH_CENTER_PORT=9100
AUTH_CENTER_BIND_IP=0.0.0.0
MONITOR_AGENT_PORT=9101
MONITOR_AGENT_BIND_IP=0.0.0.0
MONITOR_CENTER_PORT=9102
MONITOR_CENTER_BIND_IP=0.0.0.0
NETWORK_GROUPS=x-sentinel-control,x-sentinel_app,x-sentinel_data,x-sentinel_monitoring
CONTROL_NETWORK_NAME=x-sentinel-control
CONTROL_NETWORK_EXTERNAL=true
APP_NETWORK_NAME=x-sentinel_app
APP_NETWORK_EXTERNAL=true
DATA_NETWORK_NAME=x-sentinel_data
DATA_NETWORK_EXTERNAL=true
MONITORING_NETWORK_NAME=x-sentinel_monitoring
MONITORING_NETWORK_EXTERNAL=true
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Nacos bootstrap. These are the only connection settings that must remain
# local; application, PostgreSQL, Redis and worker settings can be supplied by
# the Nacos Config document.
SERVICE_AUTH_URL=
SERVICE_CLIENT_SECRET_FILE=/etc/xsentinel/secrets/backend.secret
MONITOR_CENTER_URL=
MONITOR_REQUEST_TIMEOUT_SECONDS=4
MONITOR_STALE_SECONDS=45
SERVICE_AUTH_RATE_LIMIT=120
SERVICE_AUTH_TOKEN_LIFETIME_SECONDS=120
MONITOR_INTERVAL_SECONDS=10
MONITOR_TIMEOUT_SECONDS=3
MONITOR_CONCURRENCY=8
NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=X_SENTINEL
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_ADVERTISE_IP=
NACOS_CONFIG_ENABLED=true
NACOS_CONFIG_DATA_ID=x-sentinel-config.json
NACOS_CONFIG_GROUP=X_SENTINEL
NACOS_CONFIG_TIMEOUT_SECONDS=3
NACOS_CONFIG_REQUIRED=false
XHS_TRANSPORT=redis
XHS_SERVICE_NAME=xsentinel-xhs-worker
XHS_SERVICE_PORT=8006

# PostgreSQL 17. These values are the local bootstrap cache used to create the
# Compose data container; application replicas read the authoritative values
# from Nacos after startup.
POSTGRES_DATABASE=xsentinel
POSTGRES_USER=xsentinel
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_EXPORTER_PASSWORD=change-me-exporter
POSTGRES_POOL_SIZE=3
POSTGRES_MAX_OVERFLOW=2
POSTGRES_POOL_RECYCLE_SECONDS=1800

# Redis 7. The password/coordinates are likewise refreshed by make nacos-config
# when a remote Nacos document is present.
REDIS_PASSWORD=change-me-redis
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_MAXMEMORY=64mb

# Authentication (production JWT secret must be at least 32 characters)
JWT_SECRET_KEY=development-only-change-me-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now-please

# X API v2. Leave empty only when developing without live polling.
# X Bearer Token is entered in the administration UI and encrypted in PostgreSQL.
X_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
X_TOKEN_CACHE_TTL_SECONDS=300
X_API_BASE_URL=https://api.x.com/2
X_REQUEST_TIMEOUT_SECONDS=20
X_MAX_PAGES_PER_POLL=5
X_PAGE_SIZE=100

# AI Base URL, model and API Key are managed in the encrypted AI Data Source UI.
AI_WORKER_SCAN_INTERVAL_SECONDS=2
AI_WORKER_MAX_CONCURRENCY=3
AI_WORKER_BATCH_SIZE=50
AI_WORKER_LOCK_TTL_SECONDS=180
AI_WORKER_HEARTBEAT_TTL_SECONDS=30

# Tencent QQ official bot delivery worker. App credentials are encrypted in PostgreSQL via the UI.
QQ_AUTH_URL=https://bots.qq.com/app/getAppAccessToken
QQ_API_BASE_URL=https://api.sgroup.qq.com/
QQ_REQUEST_TIMEOUT_SECONDS=20
QQ_WORKER_SCAN_INTERVAL_SECONDS=2
QQ_WORKER_MAX_CONCURRENCY=5
QQ_WORKER_BATCH_SIZE=100
QQ_WORKER_SEND_INTERVAL_SECONDS=5
QQ_WORKER_MAX_ATTEMPTS=3
QQ_WORKER_LOCK_TTL_SECONDS=60
QQ_WORKER_HEARTBEAT_TTL_SECONDS=30

# Xiaohongshu browser worker. Browser profiles persist per admin under xhs_home.
XHS_JOB_TIMEOUT_SECONDS=300
XHS_JOB_RESULT_TTL_SECONDS=300
XHS_BROWSER_POOL_SIZE=1
XHS_BROWSER_MAX_CONCURRENCY=1
XHS_WORKER_HEARTBEAT_TTL_SECONDS=30

# Polling worker defaults; each monitored user's interval remains editable via API/UI.
DEFAULT_POLL_INTERVAL_SECONDS=300
WORKER_SCAN_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=5
WORKER_BATCH_SIZE=100
WORKER_LOCK_TTL_SECONDS=120
WORKER_HEARTBEAT_TTL_SECONDS=30

# Optional monitoring profile
PROMETHEUS_BIND_IP=0.0.0.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_BIND_IP=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# infra/scripts/backup.sh
BACKUP_DIR=./backups
