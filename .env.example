# X Sentinel runtime
APP_NAME="X Sentinel"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
STARTUP_STRICT=true
AUTO_CREATE_TABLES=true
TZ=Asia/Shanghai
IMAGE_TAG=latest

# Public web entrypoint
APP_BIND_IP=0.0.0.0
APP_PORT=8080
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# MySQL 8 (use URL-safe, randomly generated passwords in production)
MYSQL_DATABASE=xsentinel
MYSQL_USER=xsentinel
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_EXPORTER_PASSWORD=change-me-exporter
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE_SECONDS=1800

# Redis 7
REDIS_PASSWORD=change-me-redis
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_MAXMEMORY=384mb

# Authentication (production JWT secret must be at least 32 characters)
JWT_SECRET_KEY=development-only-change-me-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now-please

# X API v2. Leave empty only when developing without live polling.
# X Bearer Token is entered in the administration UI and encrypted in MySQL.
X_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
X_TOKEN_CACHE_TTL_SECONDS=300
X_API_BASE_URL=https://api.x.com/2
X_REQUEST_TIMEOUT_SECONDS=20
X_MAX_PAGES_PER_POLL=5
X_PAGE_SIZE=100

# AI Base URL, model and API Key are managed in the encrypted AI Data Source UI.
AI_WORKER_SCAN_INTERVAL_SECONDS=2
AI_WORKER_MAX_CONCURRENCY=3
AI_WORKER_BATCH_SIZE=50
AI_WORKER_LOCK_TTL_SECONDS=180
AI_WORKER_HEARTBEAT_TTL_SECONDS=30

# Polling worker defaults; each monitored user's interval remains editable via API/UI.
DEFAULT_POLL_INTERVAL_SECONDS=300
WORKER_SCAN_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=5
WORKER_BATCH_SIZE=100
WORKER_LOCK_TTL_SECONDS=120
WORKER_HEARTBEAT_TTL_SECONDS=30

# Optional monitoring profile
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# infra/scripts/backup.sh
BACKUP_DIR=./backups
