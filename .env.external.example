# External data services. Copy to .env and fill secrets before `make external-up`.
APP_NAME="X Sentinel"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
STARTUP_STRICT=true
AUTO_CREATE_TABLES=false
TZ=Asia/Shanghai

APP_BIND_IP=0.0.0.0
APP_PORT=8080
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

MYSQL_HOST=10.211.55.30
MYSQL_PORT=3306
MYSQL_DATABASE=xsentinel
MYSQL_USER=xsentinel
MYSQL_PASSWORD=replace-with-a-dedicated-app-password

REDIS_HOST=10.211.55.30
REDIS_PORT=6537
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# X Bearer Token is entered in the administration UI and encrypted in MySQL.
X_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
X_TOKEN_CACHE_TTL_SECONDS=300
X_API_BASE_URL=https://api.x.com/2
X_REQUEST_TIMEOUT_SECONDS=20
X_MAX_PAGES_PER_POLL=5
X_PAGE_SIZE=100

# AI Base URL, model and API Key are managed in the encrypted AI Data Source UI.
AI_WORKER_SCAN_INTERVAL_SECONDS=2
AI_WORKER_MAX_CONCURRENCY=3
AI_WORKER_BATCH_SIZE=50
AI_WORKER_LOCK_TTL_SECONDS=180
AI_WORKER_HEARTBEAT_TTL_SECONDS=30

# Tencent QQ official bot delivery worker. App credentials are configured in Sentinel.
QQ_AUTH_URL=https://bots.qq.com/app/getAppAccessToken
QQ_API_BASE_URL=https://api.sgroup.qq.com/
QQ_REQUEST_TIMEOUT_SECONDS=20
QQ_WORKER_SCAN_INTERVAL_SECONDS=2
QQ_WORKER_MAX_CONCURRENCY=5
QQ_WORKER_BATCH_SIZE=100
QQ_WORKER_MAX_ATTEMPTS=3
QQ_WORKER_LOCK_TTL_SECONDS=60
QQ_WORKER_HEARTBEAT_TTL_SECONDS=30

DEFAULT_POLL_INTERVAL_SECONDS=300
WORKER_SCAN_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENCY=5
WORKER_BATCH_SIZE=100
WORKER_LOCK_TTL_SECONDS=120
WORKER_HEARTBEAT_TTL_SECONDS=30
